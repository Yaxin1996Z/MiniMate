{
  "mcp": {
    "servers": [
      {
        "name": "demo",
        "transport": "stdio",
        "command": "uv",
        "args": ["run", "python", "examples/mcp_demo_server.py"],
        "env": {}
      },
      {
        "name": "notion",
        "transport": "http",
        "url": "https://mcp.notion.com/mcp",
        "headers": {},
        "oauth": {
          "client_id": "YOUR_NOTION_OAUTH_CLIENT_ID",
          "scope": "openid offline_access"
        }
      }
    ]
  }
}
